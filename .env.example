# GA4 — Admin → Data streams → 选择 Web 流 → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense — Account → Settings → Account information → Publisher ID
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456

# Bing Webmaster Tools — Settings → Site authentication → Meta tag content
NEXT_PUBLIC_BING_SITE_VERIFICATION=B41047FD8299050C156DFE424742B31D

# Find in Video — 模型分片 CDN 目录；留空时使用本站 /models。
# 在 next build 前设置；manifest 和 ONNX runtime 仍从本站读取。
NEXT_PUBLIC_FIND_IN_VIDEO_MODEL_BASE_URL=
